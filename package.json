{
  "name": "state-of-ai-in-design-systems",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server for the State of AI in Design Systems report (July 2026).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "types": "node scripts/generate_types.mjs",
    "types:check": "node scripts/generate_types.mjs --check",
    "check": "./scripts/check.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "ajv": "8.20.0",
    "simple-icons": "16.27.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@resvg/resvg-wasm": "2.6.2",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.8.0",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
