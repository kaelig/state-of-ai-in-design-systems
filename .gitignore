# Build intermediates. scripts/build.sh regenerates these.
build/

# Generated site output. Netlify runs ./scripts/build.sh on every deploy and
# publishes what that writes, so committing it only made a one-line data
# correction arrive as a 131-file diff.
#
# Three files in here are source, not output, and the build does not recreate
# them. Use `dashboard/*`, never `dashboard/**` — git cannot re-include a file
# whose parent directory is excluded, and the negations below would silently
# stop working.
dashboard/*
!dashboard/template.html
!dashboard/favicon.svg
!dashboard/og-image.png

# Dependencies and local tooling state
node_modules/
.netlify/
deno.lock
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Working files behind the dataset, not part of it. What gets published is
# data/*.json, and every claim in it carries the source URL it came from.
data/critic-review.json
data/raw/
data/verified/
db/

# One-time migration tool, kept local. Once the records are clean it has no
# further use, and build_dashboard.py already drops these fields at build time.
scripts/sanitize_data.py

# Staging note for work that isn't public yet.
docs/feedback-integration.md

# Screenshot and browser-automation artifacts
.playwright-mcp/
ov.png
*.log

# Python
__pycache__/
*.pyc

# macOS
.DS_Store
