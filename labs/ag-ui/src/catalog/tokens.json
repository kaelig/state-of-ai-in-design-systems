{
  "$description": "Harbor, the sample design system these prototypes generate UI from. DTCG 2025.10 format: colors are objects with a color space, dimensions carry a unit, and semantic tokens alias palette tokens.",
  "palette": {
    "$type": "color",
    "gray": {
      "0": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "50": { "$value": { "colorSpace": "srgb", "components": [0.973, 0.976, 0.98], "hex": "#f8f9fa" } },
      "100": { "$value": { "colorSpace": "srgb", "components": [0.925, 0.933, 0.945], "hex": "#eceef1" } },
      "200": { "$value": { "colorSpace": "srgb", "components": [0.851, 0.863, 0.886], "hex": "#d9dce2" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.408, 0.435, 0.49], "hex": "#686f7d" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.227, 0.247, 0.29], "hex": "#3a3f4a" } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.149, 0.165, 0.2], "hex": "#262a33" } },
      "900": { "$value": { "colorSpace": "srgb", "components": [0.086, 0.098, 0.125], "hex": "#161920" } }
    },
    "blue": {
      "100": { "$value": { "colorSpace": "srgb", "components": [0.878, 0.918, 1], "hex": "#e0eaff" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.569, 0.686, 1], "hex": "#91afff" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.169, 0.337, 0.882], "hex": "#2b56e1" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.122, 0.263, 0.729], "hex": "#1f43ba" } }
    },
    "green": {
      "100": { "$value": { "colorSpace": "srgb", "components": [0.863, 0.957, 0.894], "hex": "#dcf4e4" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.478, 0.82, 0.608], "hex": "#7ad19b" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.071, 0.435, 0.227], "hex": "#126f3a" } }
    },
    "amber": {
      "100": { "$value": { "colorSpace": "srgb", "components": [1, 0.945, 0.816], "hex": "#fff1d0" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.949, 0.769, 0.42], "hex": "#f2c46b" } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.549, 0.314, 0], "hex": "#8c5000" } }
    },
    "red": {
      "100": { "$value": { "colorSpace": "srgb", "components": [1, 0.894, 0.894], "hex": "#ffe4e4" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [1, 0.604, 0.576], "hex": "#ff9a93" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.702, 0.118, 0.141], "hex": "#b31e24" } }
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "canvas": { "$value": "{palette.gray.50}" },
      "surface": { "$value": "{palette.gray.0}" },
      "subtle": { "$value": "{palette.gray.100}" }
    },
    "fg": {
      "default": { "$value": "{palette.gray.900}" },
      "muted": { "$value": "{palette.gray.500}" },
      "on-accent": { "$value": "{palette.gray.0}" }
    },
    "border": {
      "default": { "$value": "{palette.gray.200}" }
    },
    "accent": {
      "default": { "$value": "{palette.blue.600}" },
      "hover": { "$value": "{palette.blue.700}" },
      "subtle": { "$value": "{palette.blue.100}" }
    },
    "success": {
      "fg": { "$value": "{palette.green.700}" },
      "bg": { "$value": "{palette.green.100}" }
    },
    "warning": {
      "fg": { "$value": "{palette.amber.800}" },
      "bg": { "$value": "{palette.amber.100}" }
    },
    "danger": {
      "fg": { "$value": "{palette.red.700}" },
      "bg": { "$value": "{palette.red.100}" }
    }
  },
  "space": {
    "$type": "dimension",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "xl": { "$value": { "value": 24, "unit": "px" } },
    "2xl": { "$value": { "value": 32, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "lg": { "$value": { "value": 12, "unit": "px" } },
    "full": { "$value": { "value": 999, "unit": "px" } }
  },
  "font": {
    "size": {
      "$type": "dimension",
      "sm": { "$value": { "value": 13, "unit": "px" } },
      "md": { "$value": { "value": 15, "unit": "px" } },
      "lg": { "$value": { "value": 18, "unit": "px" } },
      "xl": { "$value": { "value": 22, "unit": "px" } },
      "2xl": { "$value": { "value": 28, "unit": "px" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "bold": { "$value": 700 }
    }
  }
}
