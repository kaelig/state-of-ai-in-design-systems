// Config for `npx fallow dead-code`, which walks the JavaScript import graph
// looking for files nothing reaches. Almost nothing in this repo is reached by
// an import: the build is a shell script that runs each step by path, and the
// two Netlify runtimes are discovered by directory convention. Fallow cannot
// see either edge, so every entry point below has to be declared by hand or the
// tool reports the whole build as dead.
{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

  // Mirrors scripts/build.sh and scripts/check.sh. If a step is added to or
  // dropped from either script, it belongs here too — the list is deliberately
  // explicit rather than `scripts/*.mjs`, so a script that stops being run
  // stops being an entry point and gets reported.
  //
  // scripts/generate_types.mjs is absent on purpose: it is an npm script, which
  // fallow already discovers from package.json.
  "entry": [
    "scripts/validate_data.mjs", // build.sh step 0
    "scripts/build_og.mjs", // build.sh step 3
    "scripts/prerender.mjs", // build.sh step 5
    "scripts/build_favicon.mjs", // build.sh step 6
    "scripts/check_contrast.js", // check.sh, before the build

    // check.sh runs this one by path. The rest of tests/ is reached through the
    // `npm test` glob in package.json, which fallow already reads, but that
    // glob is *.test.mjs and this file is Deno TypeScript.
    "tests/trailing-punctuation.test.ts",

    // Netlify's two runtimes. None of these is imported by anything; the
    // platform finds them by path and reads the route out of the exported
    // config. netlify/edge-functions/lib/md-routes.ts is generated by
    // scripts/build_md.py and reached from markdown.ts, so it needs no entry.
    "netlify/functions/mcp.mjs",
    "netlify/edge-functions/markdown.ts",
    "netlify/edge-functions/trailing-punctuation.ts",
  ],

  // scripts/build_dashboard.py reads node_modules/simple-icons/icons/<slug>.svg
  // for the three platform marks the package carries. That is a real build-time
  // dependency and the reason the package sits in `dependencies`, but the
  // reader is Python, so no JavaScript import will ever account for it.
  "ignoreDependencies": ["simple-icons"],

  // dev-dependencies-in-production asks whether a `--omit=dev` install would
  // break an import at runtime. Nothing here is ever installed that way and then
  // run: Netlify installs everything and runs scripts/build.sh, and the MCP
  // function ships as an esbuild bundle with its imports already inlined. The
  // one file the rule fires on, scripts/generate_types.mjs, is reached only from
  // `npm run check`, which needs eslint and tsc to get that far — so an install
  // that lacked json-schema-to-typescript could never have reached it.
  //
  // Off rather than an ignoreDependencies entry, which would also stop fallow
  // reporting the package if generate_types.mjs were ever deleted.
  "rules": { "dev-dependencies-in-production": "off" },
}
