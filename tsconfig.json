{
  "// why": [
    "No files are renamed to .ts. Types arrive through JSDoc, checked by allowJs",
    "+ checkJs, so the build keeps running the same .mjs files Node already runs.",
    "netlify/edge-functions/ is excluded on purpose: those files import netlify:edge",
    "and run on Deno, which tsc cannot resolve. `deno check` covers them instead."
  ],
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext"],
    "types": ["node"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // strict, minus noImplicitAny. Turning it on reports 200 errors across
    // netlify/functions/mcp.mjs, scripts/prerender.mjs and scripts/check_contrast.js,
    // all of them missing JSDoc annotations rather than defects. The ratchet is
    // to annotate a file, then add it to a stricter override — not to hold the
    // whole repo unchecked until every parameter has a type.
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Off deliberately. See types/build-payloads.d.ts: the imported JSON is a
    // 694KB generated payload whose inferred literal type is accidental and
    // expensive. types/data.d.ts carries the real, schema-derived shape.
    "resolveJsonModule": false
  },
  "include": [
    "scripts/**/*.mjs",
    "scripts/**/*.js",
    "netlify/functions/**/*.mjs",
    "server/**/*.mjs",
    "tests/**/*.mjs",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dashboard",
    "build",
    ".netlify",
    "netlify/edge-functions"
  ]
}
